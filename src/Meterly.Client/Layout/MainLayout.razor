@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="d-flex" style="background-color: #EFECE5; min-height: 100vh; overflow: hidden;">
    <!-- Floating Sidebar -->
    <div class="floating-sidebar d-flex flex-column align-center py-6">
        <MudIconButton Icon="@Icons.Material.Filled.Stream" Style="color: #637A68; font-size: 32px;" Class="mb-8" OnClick="@(() => NavigationManager.NavigateTo("/"))" />
        
        <MudTooltip Text="Dashboard" Placement="Placement.Right">
            <MudIconButton Icon="@Icons.Material.Filled.Dashboard" 
                           Style="@GetSidebarStyle("/")" 
                           OnClick="@(() => NavigateTo("/"))" />
        </MudTooltip>
        <MudTooltip Text="Invoices" Placement="Placement.Right">
            <MudIconButton Icon="@Icons.Material.Filled.Receipt" 
                           Style="@GetSidebarStyle("/invoices")" 
                           OnClick="@(() => NavigateTo("/invoices"))" />
        </MudTooltip>
        <MudTooltip Text="Customers" Placement="Placement.Right">
            <MudIconButton Icon="@Icons.Material.Filled.People" 
                           Style="@GetSidebarStyle("/customers")" 
                           OnClick="@(() => NavigateTo("/customers"))" />
        </MudTooltip>
        <MudTooltip Text="Products" Placement="Placement.Right">
            <MudIconButton Icon="@Icons.Material.Filled.Inventory2" 
                           Style="@GetSidebarStyle("/products")" 
                           OnClick="@(() => NavigateTo("/products"))" />
        </MudTooltip>
        
        <MudSpacer />
        
        <MudTooltip Text="Settings" Placement="Placement.Right">
            <MudIconButton Icon="@Icons.Material.Filled.Settings" 
                           Style="color: #637A68;" />
        </MudTooltip>
        <MudTooltip Text="Log out" Placement="Placement.Right">
            <MudIconButton Icon="@Icons.Material.Filled.Logout" 
                           Style="color: #637A68;" 
                           OnClick="HandleLogout" />
        </MudTooltip>
        <MudAvatar Color="Color.Dark" Class="mt-4">
            <MudIcon Icon="@Icons.Material.Filled.Person" />
        </MudAvatar>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 px-10 py-10" style="overflow-y: auto; height: 100vh;">
        @Body
    </div>
</div>

@code {
    private MudTheme _currentTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1c1c1c",
            Secondary = "#637A68",
            Background = "#EFECE5",
            Surface = "#ffffff",
            TextPrimary = "#1c1c1c",
            TextSecondary = "#6b7280",
        }
    };

    private string _currentUri = "/";

    protected override void OnInitialized()
    {
        _currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += (_, e) =>
        {
            _currentUri = NavigationManager.ToBaseRelativePath(e.Location);
            StateHasChanged();
        };
    }

    private void NavigateTo(string path)
    {
        NavigationManager.NavigateTo(path);
    }

    private string GetSidebarStyle(string path)
    {
        var relativePath = "/" + _currentUri;
        bool isActive = relativePath == path || (path != "/" && relativePath.StartsWith(path));
        if (path == "/" && relativePath == "/") isActive = true;
        
        return isActive 
            ? "color: white; background-color: #637A68; border-radius: 12px; margin: 4px 0;" 
            : "color: #637A68; margin: 4px 0;";
    }

    private async Task HandleLogout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "jwt_token");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "user_email");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "user_name");
        ((CustomAuthStateProvider)AuthStateProvider).NotifyUserLogout();
        Snackbar.Add("You have been logged out.", Severity.Info);
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
