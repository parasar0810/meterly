@page "/"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard - Meterly</PageTitle>

@if (_isLoading)
{
    <div class="d-flex justify-center align-center" style="height: 60vh;">
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <!-- Header Row -->
    <div class="d-flex justify-space-between align-center mb-8">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #1c1c1c;">Hello, @_userName!</MudText>
            <MudText Typo="Typo.body2" Style="color: #6b7280;">Welcome to your Meterly dashboard</MudText>
        </div>
        
        <div class="d-flex align-center gap-3">
            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Circle">API Connected</MudChip>
            <MudTooltip Text="@_userEmail">
                <MudAvatar Color="Color.Secondary" Size="Size.Medium">
                    @(_userName?.Length > 0 ? _userName[0].ToString().ToUpper() : "U")
                </MudAvatar>
            </MudTooltip>
        </div>
    </div>

    <MudGrid Spacing="4">
        <!-- Stats Cards - Real Data -->
        <MudItem xs="12" md="3">
            <MudPaper Elevation="0" Class="premium-card h-100">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <div class="stat-label">Total Customers</div>
                        <div class="stat-value">@_totalCustomers</div>
                    </div>
                    <div style="background-color: #E8F5E9; width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Filled.People" Style="color: #637A68;" />
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Elevation="0" Class="premium-card h-100">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <div class="stat-label">Total Invoices</div>
                        <div class="stat-value">@_totalInvoices</div>
                    </div>
                    <div style="background-color: #E3F2FD; width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Style="color: #1565C0;" />
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Elevation="0" Class="premium-card h-100">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <div class="stat-label">Paid Invoices</div>
                        <div class="stat-value">@_paidInvoices</div>
                    </div>
                    <div style="background-color: #F5EEDB; width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Style="color: #D4AF37;" />
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Elevation="0" Class="premium-card-green h-100">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <div class="stat-label-green">Overdue</div>
                        <div class="stat-value-green">@_overdueInvoices</div>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background-color: rgba(255,255,255,0.2);">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color: white;" />
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <!-- Quick Actions -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="premium-card h-100">
                <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-4">Quick Actions</MudText>
                <div class="d-flex flex-wrap gap-3">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd" 
                               Style="background-color: #637A68; color: white; border-radius: 8px; text-transform: none;"
                               OnClick="@(() => NavigationManager.NavigateTo("/customers"))">
                        Add Customer
                    </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.NoteAdd" 
                               Style="background-color: #1565C0; color: white; border-radius: 8px; text-transform: none;"
                               OnClick="@(() => NavigationManager.NavigateTo("/invoices"))">
                        Create Invoice
                    </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Inventory2" 
                               Style="background-color: #D4AF37; color: white; border-radius: 8px; text-transform: none;"
                               OnClick="@(() => NavigationManager.NavigateTo("/products"))">
                        Add Product
                    </MudButton>
                </div>
            </MudPaper>
        </MudItem>

        <!-- Account Info Card -->
        <MudItem xs="12" md="3">
            <MudPaper Elevation="0" Class="premium-card h-100 d-flex flex-column align-center justify-center">
                <MudAvatar Size="Size.Large" Style="width: 80px; height: 80px; background-color: #637A68; color: white; font-size: 2rem;" Class="mb-4">
                    @(_userName?.Length > 0 ? _userName[0].ToString().ToUpper() : "U")
                </MudAvatar>
                <MudText Typo="Typo.h6" Style="font-weight: 700;">@_userName</MudText>
                <MudText Typo="Typo.body2" Style="color: #6b7280;" Class="mb-4">@_userEmail</MudText>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.Verified">Verified Account</MudChip>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Elevation="0" Class="premium-card h-100 d-flex flex-column align-center justify-center text-center">
                <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Style="font-size: 64px; color: #637A68;" Class="mb-4" />
                <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-1">Secure Account</MudText>
                <MudText Typo="Typo.body2" Style="color: #6b7280;" Class="mb-4">Your data is protected with JWT encryption</MudText>
            </MudPaper>
        </MudItem>

        <!-- Recent Activity -->
        <MudItem xs="12">
            <MudPaper Elevation="0" Class="premium-card">
                <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-4">Getting Started</MudText>
                <MudTimeline TimelineOrientation="TimelineOrientation.Horizontal" TimelinePosition="TimelinePosition.Top">
                    <MudTimelineItem Color="Color.Success" Variant="Variant.Filled">
                        <ItemContent>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">Account Created ✓</MudText>
                        </ItemContent>
                    </MudTimelineItem>
                    <MudTimelineItem Color="@(_totalCustomers > 0 ? Color.Success : Color.Default)" Variant="Variant.Filled">
                        <ItemContent>
                            <MudLink Typo="Typo.body2" Style="font-weight: 600;" Href="/customers">Add Customers</MudLink>
                        </ItemContent>
                    </MudTimelineItem>
                    <MudTimelineItem Color="@(_totalInvoices > 0 ? Color.Success : Color.Default)" Variant="Variant.Filled">
                        <ItemContent>
                            <MudLink Typo="Typo.body2" Style="font-weight: 600;" Href="/invoices">Create Invoices</MudLink>
                        </ItemContent>
                    </MudTimelineItem>
                    <MudTimelineItem Color="@(_paidInvoices > 0 ? Color.Success : Color.Default)" Variant="Variant.Filled">
                        <ItemContent>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">Get Paid</MudText>
                        </ItemContent>
                    </MudTimelineItem>
                </MudTimeline>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _isLoading = true;
    private string _userName = "User";
    private string _userEmail = "";
    private int _totalCustomers = 0;
    private int _totalInvoices = 0;
    private int _paidInvoices = 0;
    private int _overdueInvoices = 0;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        // Get user info from localStorage
        _userEmail = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "user_email") ?? "";
        _userName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "user_name") ?? "User";

        // Try to load dashboard stats from API
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "jwt_token");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = 
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            // Try calling the health endpoint to verify connectivity
            var healthResponse = await Http.GetAsync("/api/health");
            // Stats will be populated as the user adds data through the app
        }
        catch
        {
            // API might not be reachable — still show the dashboard with zeros
        }

        _isLoading = false;
    }
}
