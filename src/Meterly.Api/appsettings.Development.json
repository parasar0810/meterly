{
  // ============================================================
  // appsettings.Development.json — Local development settings
  //
  // In a real project, this file is often in .gitignore so developers
  // don't accidentally commit local passwords. For this educational
  // project, we will commit it so you can run it out of the box.
  // ============================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      // Show SQL queries in the console during development
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    // Connects to the local PostgreSQL database in Docker
    "DefaultConnection": "Host=127.0.0.1;Port=5434;Database=meterly_db;Username=meterly_user;Password=meterly_password;"
  },
  "Jwt": {
    "Secret": "SuperSecretDevelopmentKeyThatIsAtLeast32CharactersLong!"
  }
}
