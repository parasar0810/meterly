@using System.ComponentModel.DataAnnotations
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="d-flex flex-column gap-4">
                <MudTextField @bind-Value="_model.Name" Label="Product Name" For="@(() => _model.Name)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_model.Description" Label="Description (Optional)" For="@(() => _model.Description)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
            </div>
            
            <div class="d-flex justify-end gap-2 mt-6">
                <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Saving...</MudText>
                    }
                    else
                    {
                        <MudText>Save</MudText>
                    }
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private ProductModel _model = new();
    private bool _isLoading;

    private async Task Submit()
    {
        _isLoading = true;
        try
        {
            // Call API to create product (no controller endpoint yet but we can mock or catch)
            var response = await Http.PostAsJsonAsync("/api/products", new
            {
                Name = _model.Name,
                Description = _model.Description
            });

            if (response.IsSuccessStatusCode)
            {
                var id = await response.Content.ReadFromJsonAsync<Guid>();
                MudDialog.Close(DialogResult.Ok(new Pages.Products.ProductViewModel
                {
                    Id = id,
                    Name = _model.Name,
                    Description = _model.Description,
                    IsActive = true
                }));
            }
            else
            {
                // In a real app, handle error
                MudDialog.Cancel();
            }
        }
        catch
        {
            // If the endpoint isn't built yet, we can mock it here for the UI flow
            MudDialog.Close(DialogResult.Ok(new Pages.Products.ProductViewModel
            {
                Id = Guid.NewGuid(),
                Name = _model.Name,
                Description = _model.Description,
                IsActive = true
            }));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public class ProductModel
    {
        [Required]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }
    }
}
