{
  // ============================================================
  // appsettings.json — Production defaults
  //
  // This file is committed to source control. Never put secrets here.
  // Secrets (connection strings, JWT keys) go in:
  //   - appsettings.Development.json (local dev, git-ignored)
  //   - Environment variables (Docker, CI/CD, production)
  //   - User Secrets (dotnet user-secrets — local dev, never committed)
  //
  // The configuration system merges these sources in this order:
  // appsettings.json < appsettings.{Environment}.json < Environment variables
  // Higher overrides lower. This lets you override dev settings in prod.
  // ============================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Placeholder — the real value is in appsettings.Development.json
    // or set via the CONNECTIONSTRINGS__DEFAULTCONNECTION environment variable.
    "DefaultConnection": ""
  },
  "Jwt": {
    // JWT configuration — values set per environment.
    // The Secret MUST be at least 32 characters for HMAC-SHA256.
    // Added in Phase 3.
    "Secret": "",
    "Issuer": "Meterly",
    "Audience": "MeterlyClients",
    "ExpiryMinutes": 60
  }
}
