@page "/"

<PageTitle>Dashboard - Meterly</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6 font-weight-bold" Color="Color.Primary">Dashboard</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 rounded-lg d-flex flex-column align-center justify-center border-l-4 border-solid" Style="border-left-color: var(--mud-palette-primary);">
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">Total Revenue</MudText>
            <MudText Typo="Typo.h4" Class="font-weight-bold">$24,590</MudText>
            <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-2 d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Class="mr-1" /> +12% this month
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 rounded-lg d-flex flex-column align-center justify-center border-l-4 border-solid" Style="border-left-color: var(--mud-palette-info);">
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">Active Customers</MudText>
            <MudText Typo="Typo.h4" Class="font-weight-bold">1,204</MudText>
            <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-2 d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Class="mr-1" /> +3% this month
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 rounded-lg d-flex flex-column align-center justify-center border-l-4 border-solid" Style="border-left-color: var(--mud-palette-warning);">
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">Pending Invoices</MudText>
            <MudText Typo="Typo.h4" Class="font-weight-bold">45</MudText>
            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2 d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" /> 12 overdue
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 rounded-lg d-flex flex-column align-center justify-center border-l-4 border-solid" Style="border-left-color: var(--mud-palette-success);">
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">Successful Payments</MudText>
            <MudText Typo="Typo.h4" Class="font-weight-bold">98.5%</MudText>
            <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-2 d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" /> Looking good
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Elevation="2" Class="pa-6 rounded-lg h-100">
            <MudText Typo="Typo.h6" Class="mb-4">Revenue Overview</MudText>
            <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@_series" XAxisLabels="@_xAxisLabels" Width="100%" Height="300px"></MudChart>
        </MudPaper>
    </MudItem>
    
    <MudItem xs="12" md="4">
        <MudPaper Elevation="2" Class="pa-6 rounded-lg h-100">
            <MudText Typo="Typo.h6" Class="mb-4">Recent Activity</MudText>
            <MudTimeline TimelinePosition="TimelinePosition.Left">
                <MudTimelineItem Color="Color.Success" Size="Size.Small">
                    <MudText Typo="Typo.body2">Payment received from <b>Acme Corp</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">10 mins ago</MudText>
                </MudTimelineItem>
                <MudTimelineItem Color="Color.Warning" Size="Size.Small">
                    <MudText Typo="Typo.body2">Dunning notice sent to <b>TechFlow</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">2 hours ago</MudText>
                </MudTimelineItem>
                <MudTimelineItem Color="Color.Info" Size="Size.Small">
                    <MudText Typo="Typo.body2">New customer signed up: <b>Globex</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">5 hours ago</MudText>
                </MudTimelineItem>
            </MudTimeline>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<ChartSeries<double>> _series = new List<ChartSeries<double>>()
    {
        new ChartSeries<double>() { Name = "Revenue", Data = new double[] { 12000, 15000, 14000, 18000, 20000, 24590 } }
    };
    
    private string[] _xAxisLabels = { "Jan", "Feb", "Mar", "Apr", "May", "Jun" };
}
